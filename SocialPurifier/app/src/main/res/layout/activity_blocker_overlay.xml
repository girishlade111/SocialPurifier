<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="24dp">

    <!-- Glowing Purifier Icon -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_launcher"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/overlay_blocked_title"
        android:textColor="@color/primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_blocker_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distraction Purified.\nTake a deep breath and stay in control."
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btn_return_home"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/overlay_return_home"
        android:background="@color/primary"
        android:textColor="@color/on_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="36dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SocialPurifier by LadeStack"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="24dp" />

</LinearLayout>
